FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY services/api/requirements-dev.txt ./requirements-dev.txt
COPY services/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY packages/event_schemas ./event_schemas
COPY services/simulator/ev_fleet_simulator ./ev_fleet_simulator
COPY services/ingestion/app ./evfleet_ingestion
COPY services/stream_processor/app ./evfleet_processor
COPY services/api/app/security.py ./security.py
COPY services/api/app/charging.py ./charging.py
COPY tests/unit ./tests/unit
COPY tests/integration ./tests/integration
ENV PYTHONPATH=/app
CMD ["pytest", "-q", "/app/tests/unit"]
