# Copy to .env for local overrides. Values here are development-only.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRAFANA_ADMIN_PASSWORD=

# Replace before any non-local deployment. Never commit real secrets.
JWT_SECRET=
DEMO_OPERATOR_EMAIL=operator@demo.local
DEMO_OPERATOR_PASSWORD=

POSTGRES_DB=evfleet
POSTGRES_USER=evfleet
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLISHED_PORT=15432

MONGO_INITDB_ROOT_USERNAME=evfleet
MONGO_INITDB_ROOT_PASSWORD=
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_PUBLISHED_PORT=27018

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=16379

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PUBLISHED_PORT=19092
INGESTION_WORKERS=4
INGESTION_QUEUE_CAPACITY=10000
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_PUBLISHED_PORT=11883
SIMULATOR_MODE=DEMO_MODE
SIMULATOR_SEED=20260930
SIMULATOR_VEHICLE_COUNT=1000
SIMULATOR_EVENTS_PER_SECOND=20
SIMULATOR_DUPLICATE_RATE=0.01
SIMULATOR_OUT_OF_ORDER_RATE=0.02
SIMULATOR_MALFORMED_RATE=0
SIMULATOR_UNKNOWN_EVENT_RATE=0
SIMULATOR_FAULT_RATE=0.001
SIMULATOR_BURST_MULTIPLIER=3
SIMULATOR_BURST_INTERVAL_SECONDS=900
SIMULATOR_BURST_DURATION_SECONDS=300
SEED_VEHICLE_COUNT=100000

VITE_API_BASE_URL=http://localhost:8000/api/v1
